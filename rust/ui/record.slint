// A local record sleeve stands in for missing artwork, including offline libraries.
export component RecordSleeve inherits Rectangle {
    in property<int> variant;
    property<int> palette: mod(variant, 4);
    property<color> paper: palette==0 ? #86b9aa : palette==1 ? #dfa284 : palette==2 ? #9eaad1 : #d4c88f;
    property<color> print: palette==0 ? #254d46 : palette==1 ? #60362f : palette==2 ? #384467 : #555136;
    property<color> label: palette==0 ? #ffba8b : palette==1 ? #e7d69d : palette==2 ? #d5bddc : #e78c70;
    background:root.paper; clip:true;
    // Two broad blocks of ink and a ruled margin give the cover its printed surface.
    Path {width:parent.width;height:parent.height;viewbox-width:320;viewbox-height:180;
        fill:root.print.transparentize(77%);commands:"M0 0H320L0 180Z";}
    for n in 9: Rectangle {
        x:parent.width * 0.055 + n * parent.width * 0.013; y:parent.height * 0.83;
        width:max(1px,parent.width * 0.004); height:parent.height * 0.11;
        background:root.print.transparentize(24%);
    }
    disc := Rectangle {
        width:max(parent.width * 0.66,parent.height * 1.04);height:self.width;
        x:parent.width * 0.69 - self.width * 0.5;y:(parent.height - self.height) * 0.48;
        border-radius:self.width / 2;
        background:@linear-gradient(128deg,#0f2222 0%,#375454 29%,#142828 51%,#294044 74%,#102020 100%);
        for i in 12: Rectangle {
            property<length> inset:parent.width * (0.025 + i * 0.023);
            x:self.inset;y:self.inset;width:parent.width - self.inset * 2;height:self.width;
            border-radius:self.width / 2;border-width:1px;border-color:#b4d9cd32;
        }
        Rectangle {
            width:parent.width * 0.34;height:self.width;x:(parent.width - self.width) / 2;y:self.x;
            border-radius:self.width / 2;background:root.label;
            Rectangle {x:(parent.width - self.width)/2;y:self.x;width:parent.width * 0.11;height:self.width;
                border-radius:self.width / 2;background:#1d302e;}
        }
    }
}
