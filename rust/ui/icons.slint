            root.glyph == Glyph.play ? "M8 5v14l11-7z" : root.glyph == Glyph.pause ? "M6 5h4v14H6zm8 0h4v14h-4z" :
            root.glyph == Glyph.previous ? "M6 6h2v12H6zm3.5 6 8.5 6V6z" :
