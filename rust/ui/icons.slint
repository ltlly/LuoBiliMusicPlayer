export component IconButton inherits Rectangle {
    in property <Glyph> glyph;
    in property <color> tint;
    in property <string> label;
    callback clicked();
    width:48px; height:48px; accessible-role:button; accessible-label:label;
    accessible-action-default=>{root.clicked();}
    Icon {x:12px;y:12px;width:24px;height:24px;glyph:root.glyph;tint:root.tint;}
    TouchArea {clicked=>{root.clicked();}}
}
