+
+// Initialization can fail inside node creation, before Asuka installs its listeners.
+static void report_unavailable(void *ctx) {
+	wh_web *w = ctx;
+	static const char message[] = "WebView2 unavailable";
+	if (!w->closed) wh_emit_str(w->n, AK_EVENT_FAILED, message, sizeof message - 1);
+	web_unref(w);
+}
+
+static void web_unavailable(wh_web *w) {
+	if (w->closed) return;
+	InterlockedIncrement(&w->refs);
+	wh_post(report_unavailable, w);
+}
+
+static void on_process_failed(wh_web *w, uintptr_t a, void *args) {
+	(void)a;
+	int kind;
+	// A browser or main renderer exit destroys this page. Edge recovers other subprocesses itself.
+	if (SUCCEEDED(CALL_P(args, PROCESS_FAILED_GET_KIND, &kind)) && (kind == 0 || kind == 1))
+		web_unavailable(w);
 }
 
