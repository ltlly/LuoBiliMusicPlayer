+
+// Let the shell recognize the position of the main window's custom maximize
+// button for Snap Layouts. The other two buttons use normal client input.
+bool wh_main_max_hit(HWND hwnd, LPARAM lp) {
+	wh_wctl *c = H.main_ctl;
+	if (!c || !c->hidden || c->full || GetAncestor(hwnd, GA_ROOT) != c->hwnd) return false;
+	POINT pt = {GET_X_LPARAM(lp), GET_Y_LPARAM(lp)};
+	ScreenToClient(c->hwnd, &pt);
+	RECT r;
+	GetClientRect(c->hwnd, &r);
+	int bw = roundi(BUTTON_WIDTH * wh_ctl_k(c));
+	return pt.y >= 0 && pt.y < roundi(CAPTION_HEIGHT * wh_ctl_k(c))
+		&& pt.x >= r.right - 2 * bw && pt.x < r.right - bw;
 }
 
