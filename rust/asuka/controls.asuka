struct Palette {
  paper: Color = #F3F9FB
  surface: Color = #FFFFFF
  ink: Color = #102C3E
  secondary: Color = #496776
  rule: Color = #CEE3E8
  soft: Color = #E1EFF3
  accent: Color = #06657D
  accentWash: Color = #CCEFF4
}

fn colorsFor(mode: string, systemDark: bool) -> Palette {
  if mode == "DARK" || (mode != "LIGHT" && systemDark) {
    return Palette(
      paper: #0C1425, surface: #131F35, ink: #F1FBFF, secondary: #A5BFCD,
      rule: #2B3B56, soft: #1C3648, accent: #86D7FF, accentWash: #193E51)
  }
  return Palette()
}

fn contentInset(width: float) -> float = if width >= 720 { 32.0 } else if width < 355 { 16.0 } else { 22.0 }

component IconAction(symbol: string, name: string, fg: Color, bg: Color, diameter: float = 40.0, iconSize: float = 20.0) {
  event press
  View {
    role: .button; label: name; width: diameter; height: diameter; radius: diameter / 2
    align: .center; justify: .center; background: bg
    on press { emit press }
    pressed { opacity: 0.72 }
    Glyph(symbol, fg, iconSize)
  }
}

component Pill(text: string, symbol: string, fg: Color, bg: Color) {
  event press
  Row {
    role: .button; label: text; alignSelf: .start; align: .center; justify: .center
    gap: 7; minHeight: 38; padding: [6, 13]; radius: 18; background: bg
    on press { emit press }
    pressed { opacity: 0.72 }
    if !symbol.isEmpty() { Glyph(symbol, fg, 16.0) }
    Text(text) { color: fg; font: Font(size: 13).semibold(); lines: 1 }
  }
}

component Brand(inverse: bool = false) {
  let palette = colorsFor(player.themeMode, environment().dark)
  Row {
    align: .center; gap: 8
    Glyph("ribbon", if inverse { #D9FAFF } else { palette.accent }, 26.0)
    Text("哔哩音乐") { color: if inverse { #FFFFFF } else { palette.ink }; font: Font(size: 17).semibold() }
  }
}

component CoverImage(source: string, fallback: string, corner: float) {
  state path = ""
  task(source) {
    path = ""
    let url = source
    if !url.isEmpty() { path = await spawn { lbm_cover(url) } }
  }
  Image(if path.isEmpty() { fallback } else { path }) {
    width: 100%; height: 100%; mode: .fill; radius: corner
  }
}

component Art(source: string, size: float, fallback: string = "singer-cover.jpg", corner: float = 8.0) {
  View { width: size; height: size; CoverImage(source, fallback, corner) }
}

fn albumFallback(index: int) -> string = ["sleeve-kite.jpg", "sleeve-jade.jpg", "sleeve-fan.jpg", "sleeve-stars.jpg"][index % 4]

component Card {
  let palette = colorsFor(player.themeMode, environment().dark)
  prop children: View
  Column {
    background: palette.surface; radius: 12; padding: 17; gap: 12
    children
  }
}

component SectionName(title: string, symbol: string) {
  let palette = colorsFor(player.themeMode, environment().dark)
  Row {
    align: .center; gap: 9
    Glyph(symbol, palette.accent, 18.0)
    Text(title) { color: palette.ink; font: Font(size: 16).bold() }
  }
}
