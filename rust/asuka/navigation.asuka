component Navigation(wide: bool, panel: string) {
  let palette = colorsFor(player.themeMode, environment().dark)
  event choose(page: string)
  fn active(page: string, current: string, openPanel: string) -> bool = openPanel.isEmpty() && (page == current || (page == "favorites" && current == "content") || (page == "settings" && current == "downloadSettings"))
  View {
    direction: if wide { .column } else { .row }; gap: if wide { 6 } else { 1 }
    padding: if wide { 0 } else { [4, 8] }; background: if wide { palette.paper } else { palette.surface }
    for page in tabs key page {
      View {
        direction: if wide { .row } else { .column }; grow: if wide { 0 } else { 1 }
        align: .center; justify: if wide { .start } else { .center }
        padding: if wide { [11, 13] } else { [3, 0] }; gap: if wide { 12 } else { 3 }
        minHeight: if wide { 46 } else { 47 }; radius: 12
        background: if wide && active(page, player.page, panel) { palette.violetWash } else { #00000000 }
        role: .button; label: pageName(page)
        on press { emit choose(page) }
        pressed { opacity: 0.65 }
        View {
          width: if wide { 23 } else { 42 }; height: 24; radius: 12; align: .center; justify: .center
          background: if !wide && active(page, player.page, panel) { palette.violetWash } else { #00000000 }
          Glyph(page, if active(page, player.page, panel) { palette.violet } else { palette.secondary }, 20.0)
        }
        Text(pageName(page)) { font: if wide { Font(size: 15).semibold() } else { Font(size: 11).semibold() }; color: if active(page, player.page, panel) { palette.violet } else { palette.secondary } }
      }
    }
  }
}
