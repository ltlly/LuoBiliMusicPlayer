component Preferences {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  state errorsOpen = false
  Scroll {
    grow: 1
    Column {
      padding: [6,inset,18,inset]; gap: 11
      if player.page == "settings" {
        if player.pendingReplacement {
          Card {
            SectionName("恢复旧版音频","wave")
            Text("音质升级曾中断，原音频有一份恢复副本。") { color: palette.secondary }
            Pill("使用副本恢复歌曲","back",palette.accent,palette.accentWash) { on press { action("recoverAudio") } }
          }
        }
        Card {
          SectionName("账户","account")
          Text(player.account) { color: palette.ink; font: .subheadline }
          if !player.accountDetail.isEmpty() { Text(player.accountDetail) { color: palette.secondary; font: .footnote } }
          Row {
            gap: 7; wrap: true
            Pill("检查登录状态","refresh",palette.accent,palette.accentWash) { on press { action("account") } }
            if player.account == "未登录" {
              Pill("扫码登录","",palette.ink,palette.soft) { on press { go("login") } }
            } else {
              Pill("退出登录","",palette.secondary,palette.soft) {
                on press { confirmAction("退出当前账户？", "退出", () => action("logout")) }
              }
            }
          }
        }
        Row {
          padding: [15,17]; gap: 9; align: .center; background: palette.surface; border: 1; borderColor: palette.rule; radius: 15
          role: .button; label: "下载设置"; on press { go("downloadSettings") }; pressed { opacity: 0.7 }
          Glyph("downloads",palette.accent,18.0)
          Text("下载设置") { grow: 1; color: palette.ink; font: Font(size: 16).bold() }
          Glyph("right",palette.secondary,14.0)
        }
        if player.loggedIn {
          Card {
            SectionName("收藏夹","favorites")
            Row { align: .center; gap: 8
              View {
                grow: 1; minHeight: 44; justify: .center; role: .button; label: "自动清理失效视频"
                on press { action("autoClean",if player.autoClean { "0" } else { "1" }) }
                Text("自动清理失效视频") { color: palette.ink }
              }
              Toggle { on: player.autoClean; label: "自动清理失效视频"; on change(v) { action("autoClean",if v { "1" } else { "0" }) } }
            }
            Text("每天分批检查自己的收藏夹，移除 B 站标记失效的视频及对应的本地下载。") { color: palette.secondary; font: .footnote }
          }
        }
        Card {
          SectionName("外观","sun")
          ChoiceBar(["跟随系统", "浅色", "深色"], if player.themeMode == "DARK" { 2 } else if player.themeMode == "LIGHT" { 1 } else { 0 }, "外观主题") {
            on change(i) { action("theme", ["SYSTEM", "LIGHT", "DARK"][i]) }
          }
        }
        if !player.qualityStatus.isEmpty() {
          Card {
            SectionName("已有歌曲音质","wave")
            if !player.qualitySummary.isEmpty() { Text(player.qualitySummary) { color: palette.secondary; font: .footnote } }
            if player.qualityFailures {
              Pill(if errorsOpen { "收起失败详情" } else { "查看失败详情" },"",palette.ink,palette.soft) { on press { errorsOpen = !errorsOpen } }
              if errorsOpen { Text(player.qualityErrors) { color: palette.secondary; font: .footnote } }
            }
            if player.qualityStatus == "running" {
              Pill("暂停升级","pause",palette.accent,palette.accentWash) { on press { action("quality","pause") } }
            } else {
              Pill(if player.qualityStatus == "permission" || player.qualityStatus == "paused" { "继续升级" } else { "升级到最高音质" },"downloads",palette.accent,palette.accentWash) { on press { action("quality","start") } }
              if player.qualityFailures { Pill("重试失败的歌曲","refresh",palette.ink,palette.soft) { on press { action("quality","retry") } } }
            }
          }
        }
        Text("哔哩音乐 1.7.4") { color: palette.secondary; font: .footnote; alignSelf: .center }
      } else {
        Card {
          SectionName("保存目录","favorites")
          Text(player.downloadDir) { color: palette.secondary; font: .subheadline }
        }
        Card {
          SectionName("下载","downloads")
          Row {
            align: .center; gap: 8
            Text("仅 Wi-Fi 下载") { grow: 1; color: palette.ink }
            Toggle { on: player.wifiOnly; label: "仅 Wi-Fi 下载"; on change(v) { action("option","wifi_only",if v { "1" } else { "0" }) } }
          }
          View { height: 1; background: palette.rule }
          Row {
            align: .center; gap: 8
            Text("同时下载 {player.concurrent} 首") { grow: 1; color: palette.ink }
            Stepper { value: player.concurrent.float(); min: 1; max: 8; on change(v) { action("option","max_concurrent_downloads","{v.int()}") } }
          }
        }
        Card {
          SectionName("请求频率","settings")
          Row {
            align: .center; gap: 8
            Text("限制请求频率") { grow: 1; color: palette.ink }
            Toggle { on: player.rateEnabled; label: "限制请求频率"; on change(v) { action("option","api_rate_limit_enabled",if v { "1" } else { "0" }) } }
          }
          if player.rateEnabled {
            Row {
              align: .center; gap: 8
              Text("每分钟 {player.rateLimit} 次") { grow: 1; color: palette.ink }
              Stepper { value: player.rateLimit.float(); min: 10; max: 60; on change(v) { action("option","api_rate_limit_per_minute","{v.int()}") } }
            }
          }
          Pill("清理已过期的冷却记录","",palette.ink,palette.soft) { on press { action("clearCooldown") } }
        }
        Card {
          SectionName("缓存","library")
          Pill("清除播放和封面缓存（{player.cacheSize}）","",palette.ink,palette.soft) {
            on press { confirmAction("清除播放和封面缓存？", "清除", () => action("clearCache")) }
          }
        }
      }
    }
  }
}
