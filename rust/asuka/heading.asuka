component Masthead {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  event queue
  Row {
    padding: [5, inset]; align: .center; justify: .spaceBetween
    Brand()
    IconAction("queue", "队列", palette.ink, #00000000, 44.0) { on press { emit queue } }
  }
}

component PageTitle(title: string, count: string = "", refresh: bool = false, back: bool = false) {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  event returnPage
  event refreshPage
  Row {
    align: .center; gap: 9; padding: [8, inset, 8, inset]
    if back { IconAction("back", "返回", palette.ink, palette.soft, 36.0, 17.0) { on press { emit returnPage } } }
    Text(title) { shrink: 1; color: palette.ink; font: Font(size: 25).semibold(); lines: 1 }
    if !count.isEmpty() { Text(count) { color: palette.secondary; font: Font(size: 13); lines: 1 } }
    View { grow: 1 }
    if refresh { IconAction("refresh", "刷新", palette.secondary, #00000000, 42.0, 17.0) { on press { emit refreshPage } } }
  }
}

component ListeningCover {
  let inset = contentInset(environment().width)
  let wide = environment().width >= 720
  let hasTrack = !player.trackTitle.isEmpty()
  let height = if wide { min(365.0, max(240.0, environment().height * 0.45)) } else if hasTrack { min(375.0, max(224.0, environment().height * 0.40)) } else { min(272.0, environment().height * 0.35) }
  event open
  event queue
  View {
    height: height; clip: true; background: #302635
    CoverImage(if hasTrack { player.smallCoverUrl } else { "" }, "mountain-dusk.jpg", 0.0)
    View {
      absolute: true; top: 0; left: 0; width: 100%; height: 100%
      gradient: Gradient(stops: [Stop(color: #0F0B1748, at: 0), Stop(color: #0F0B1708, at: 0.35), Stop(color: #110D19A8, at: 0.78), Stop(color: #111014, at: 1)])
    }
    if hasTrack {
      View {
        absolute: true; top: 0; left: 0; width: 100%; height: 100%
        role: .button; label: "展开播放器"; on press { emit open }
      }
    }
    if !wide {
      Row {
        absolute: true; top: 6; left: 0; right: 0; padding: [0, inset]; align: .center; justify: .spaceBetween
        Brand(true)
        IconAction("queue", "队列", #FFFFFF, #18121D50, 40.0, 19.0) { on press { emit queue } }
      }
    }
    Row {
      absolute: true; bottom: if wide { 26 } else { 18 }; left: 0; right: 0
      padding: [0, inset]; align: .end; gap: 9
      Column {
        grow: 1; shrink: 1; gap: 4
        if hasTrack {
          Row { align: .center; gap: 7
            Glyph("wave", #FFB4C2, 16.0)
            Text(if player.playing { "正在播放" } else { "继续收听" }) { color: #FFE4EA; font: Font(size: 13).medium() }
          }
        }
        Text(if hasTrack { player.trackTitle } else { "我的音乐" }) {
          color: #FFFCFE; font: Font(size: if wide { 47.0 } else { 37.0 }).medium(); lines: 2
        }
        if hasTrack && !player.artist.isEmpty() { Text(player.artist) { color: #E3DCE2; font: Font(size: 16); lines: 1 } }
      }
      if hasTrack {
        Row {
          align: .center; gap: 2
          IconAction(if player.playing { "pause" } else { "play" }, if player.playing { "暂停" } else { "播放" }, #221E25, #FEFAFC, 49.0, 23.0) { on press { control("toggle") } }
          IconAction("next","下一首",#FFFFFF,#00000000,39.0,18.0) { on press { control("next") } }
        }
      }
    }
  }
}

component Collection {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  let cols = if player.entries.count() == 1 { 1 } else if environment().width >= 1240 { 3 } else if environment().width < 330 { 1 } else { 2 }
  let count = player.entries.count()
  let rows = (count + cols - 1) / cols
  event open
  event queue
  List {
    grow: 1; appearance: .bare
    for group in 0..<(rows + 1) key group {
      if group == 0 {
        Column {
          ListeningCover { on open { emit open }; on queue { emit queue } }
          PageTitle("收藏夹", "{count} 个", true) { on refreshPage { action("retry") } }
          if !player.message.isEmpty() { Text(player.message) { margin: [2, inset, 8, inset]; color: palette.accent; font: .footnote; lines: 3 } }
          if count == 0 { Text("暂无收藏夹") { padding: [28, inset]; color: palette.secondary; font: .subheadline } }
        }
      } else {
        Row {
          margin: [0, inset, 14, inset]; gap: 14
          for col in 0..<cols key col {
            FolderSlot((group - 1) * cols + col)
          }
        }
      }
    }
  }
}

component FolderSlot(index: int) {
  if index < player.entries.count() {
    FolderTile(player.entries[index], index, player.entries.count() == 1) {
      on open { action("choose", player.entries[index].key, player.entries[index].title) }
    }
  } else { View { grow: 1; basis: 0 } }
}
