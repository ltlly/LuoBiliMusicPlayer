import std/json
import platform/nowplaying

let tabs = ["favorites", "rank", "library", "downloads", "settings"]

state appForeground = true

app {
  on foreground { appForeground = true }
  on background { appForeground = false }
  effect { setColorScheme(if player.themeMode == "DARK" { .dark } else if player.themeMode == "LIGHT" { .light } else { .system }) }
  Window {
    title: "哔哩音乐"
    width: 880
    height: 720
    minWidth: 330
    minHeight: 430
    titleBar: if @platform == .windows { .hidden } else { .default }
    View {
      grow: 1
      Music()
      if @platform == .windows { WindowChrome() }
    }
  }
}

component Music(live: bool = true) {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  let wide = environment().width >= 720
  state panel = ""
  state queueFromPlayer = false
  state query = ""
  state selected: [string] = []
  state selecting = false
  state tab = 0

  task {
    if !live { return }
    lbm_start()
    let updates = ViewUpdates()
    var revision = -1
    var rows: [Entry] = []
    var queue: [Entry] = []
    while true {
      let raw = await updates.next(revision, playhead.int())
      let seconds = lbm_position_seconds().float()
      if playhead != seconds { playhead = seconds }
      if !raw.isEmpty() {
        if let packet = try? json.decode<Player>(raw) {
          var next = packet
          if next.entriesVersion > revision { rows = next.entries } else { next.entries = rows }
          if next.queueVersion > revision { queue = next.queue } else { next.queue = queue }
          revision = next.revision
          if player.loggedIn != next.loggedIn { tabRows = [:] }
          if !next.notice.isEmpty() { triplePending = false; snackbar(next.notice, duration: .long) }
          if !requestedPage.isEmpty() && next.navigation != navigationRequest { continue }
          navigationRequest = next.navigation
          requestedPage = ""
          if player.page != next.page {
            query = ""
            selecting = false
            selected = []
            panel = ""
          }
          player = next
          rememberTab(next, query)
        }
      }
    }
  }
  task(navigationRequest) {
    let page = requestedPage
    if !live || (page != "library" && page != "downloads") || tabRows[page] != none { return }
    let token = navigationRequest
    // Usually the player has already published local rows before this point.
    await sleep(80ms)
    if token != navigationRequest || requestedPage != page { return }
    let local = LocalPages()
    let raw = await local.read(page, tab)
    if token == navigationRequest && requestedPage == page {
      if let rows = try? json.decode<[Entry]>(raw) {
        player.page = page
        player.entries = rows
        player.hasMore = false
        player.pageLoading = false
        player.message = ""
      }
    }
  }
  task(query) {
    if !query.isEmpty() {
      await sleep(400ms)
      action("search", query)
    }
  }
  onBack {
    if !activeDialog.choices.isEmpty() { activeDialog = PlayerDialog(); return true }
    if !panel.isEmpty() { dismissPanel(); return true }
    if selecting { selecting = false; selected = []; return true }
    if !query.isEmpty() { query = ""; action("search", ""); return true }
    if player.page == "rankWeb" { go("rank"); return true }
    if player.page == "content" { go("favorites"); return true }
    if player.page == "downloadSettings" { go("settings"); return true }
    return false
  }
  fn showPanel(next: string) {
    if panel == next { return }
    queueFromPlayer = next == "queue" && panel == "player"
    if @platform == .windows || environment().reduceMotion { panel = next }
    else { animate(Animation(duration: 230ms, curve: .easeOut), () => { panel = next }) }
  }
  fn dismissPanel() { showPanel(if queueFromPlayer { "player" } else { "" }) }
  fn openTab(page: string) {
    panel = ""
    if page != player.page || !requestedPage.isEmpty() {
      query = ""; rankQuery = ""; selected = []; selecting = false
      go(page)
    }
  }
  fn select(key: string) {
    if selected.contains(key) { selected.removeWhere(k => k == key) } else { selected.push(key) }
  }
  fn confirmRemoval(unsynced: bool = false) {
    let page = player.page
    let ids = selected
    let title = if unsynced { "删除未匹配的本地歌曲及其文件？" } else if page == "downloads" { "移除 {ids.count()} 条下载记录？" } else { "删除选中的 {ids.count()} 首歌曲及其文件？" }
    confirmAction(title, "删除", () => {
      if let encoded = try? json.encode(ids) { action("removeItems", encoded, if unsynced { "unsynced" } else { "" }) }
      selecting = false
      selected = []
    })
  }
  fn sendDownload(ids: [string]) {
    if let encoded = try? json.encode(ids) { action("download", encoded) }
    selecting = false
    selected = []
  }

  if @platform == .windows || @platform == .linux {
    if live && !player.trackTitle.isEmpty() {
      nowplaying.NowPlaying {
        title: player.trackTitle
        artist: player.artist
        state: if player.playing { .playing } else if player.stopped { .stopped } else { .paused }
        duration: player.duration
        position: playhead
        on play { control("play") }
        on pause { control("pause") }
        on togglePlayPause { control("toggle") }
        on stop { control("stop") }
        on previous { control("previous") }
        on next { control("next") }
        on seek(seconds) { action("seek", "{seconds}") }
        skipInterval: 10
        on skipForward(seconds) { action("seek", "{playhead + seconds}") }
        on skipBackward(seconds) { action("seek", "{max(0.0, playhead - seconds)}") }
      }
    }
  }

  SafeArea {
    grow: 1; background: palette.paper
    Row {
      grow: 1
      if wide {
        Column {
          width: if environment().width < 850 { 146 } else { 164 }; padding: [26, 13]; gap: 28; background: palette.surface
          if @platform != .windows { View { padding: [0,6]; Brand() } }
          Navigation(true, panel) { on choose(p) { openTab(p) } }
          View { grow: 1 }
          Pill("播放队列", "queue", palette.accent, palette.accentWash) { on press { showPanel("queue") } }
        }
        View { width: 1; background: palette.rule }
      }
      Column {
        grow: 1; shrink: 1
        if panel == "player" || panel == "queue" {
          NowPlaying(panel) {
            on dismiss { dismissPanel() }
            on queue { showPanel(if panel == "queue" { "player" } else { "queue" }) }
          }
        } else {
          if player.page == "favorites" {
            Collection { on open { showPanel("player") }; on queue { showPanel("queue") } }
          } else {
            if !wide { Masthead { on queue { showPanel("queue") } } }
            PageTitle(pageName(player.page), if player.page == "library" { "{player.entries.count()} 首" } else { "" },
              player.page == "library" || player.page == "content" || player.page == "downloads" || player.page == "rank",
              player.page == "content" || player.page == "downloadSettings" || player.page == "rankWeb") {
              on returnPage { go(if player.page == "content" { "favorites" } else if player.page == "rankWeb" { "rank" } else { "settings" }) }
              on refreshPage { action("retry") }
            }
            if !player.message.isEmpty() {
              Text(player.message) { color: palette.accent; font: .footnote; padding: [4,inset]; lines: 3 }
            }
            if player.page == "rank" { RankPane() } else if player.page == "rankWeb" { RankWebsite() } else if player.page == "login" {
              LoginPane()
            } else if player.page == "settings" || player.page == "downloadSettings" {
              Preferences()
            } else {
              Row {
                margin: [2,inset,5,inset]; padding: [2,11]; gap: 8; radius: 12
                border: 1; borderColor: palette.rule; background: palette.surface; align: .center
                Glyph("search",palette.secondary,17.0)
                TextField {
                  grow: 1; plain: true; minHeight: 36; text: query; placeholder: "搜索歌曲或歌手"; color: palette.ink
                  on change(t) {
                    if t.isEmpty() && !query.isEmpty() { action("search", "") }
                    query = t
                  }
                }
              }
              if player.page == "downloads" {
                ChoiceBar(["进行中", "已完成", "失败"], tab, "下载状态") {
                  margin: [3,inset]
                  on change(i) { tab = i; selected = []; selecting = false; action("downloadsTab", "{i}") }
                }
              }
              if !player.entries.isEmpty() {
                Row {
                  gap: 6; wrap: true; padding: [4,inset,7,inset]
                  if selecting {
                    Pill("全选","check",palette.accent,palette.accentWash) { on press { selected = player.entries.map(e => e.key) } }
                    if !selected.isEmpty() {
                      if player.page == "content" {
                        Pill("下载 ({selected.count()})", "downloads", palette.ink, palette.soft) { on press { sendDownload(selected) } }
                      } else {
                        Pill("删除 ({selected.count()})", "minus", palette.ink, palette.soft) { on press { confirmRemoval() } }
                      }
                    }
                    Pill("取消","",palette.ink,palette.soft) { on press { selecting = false; selected = [] } }
                  } else {
                    Pill(if player.page == "downloads" { "选择记录" } else { "选择歌曲" }, "check", palette.ink, palette.soft) { on press { selecting = true } }
                    if player.page == "content" { Pill("下载全部","downloads",palette.accent,palette.accentWash) { on press { sendDownload([]) } } }
                    if player.page == "library" { Pill("清理未匹配歌曲","",palette.secondary,palette.soft) { on press { confirmRemoval(true) } } }
                  }
                }
              }
              if player.entries.isEmpty() {
                Column {
                  grow: 1; align: .center; justify: .center; gap: 9
                  View { width: 50; height: 50; radius: 16; background: palette.accentWash; align: .center; justify: .center; Glyph(if query.isEmpty() { player.page } else { "search" },palette.accent,22.0) }
                  Text(if player.pageLoading { "正在读取歌曲…" } else if !query.isEmpty() { "没有匹配的歌曲" } else if player.page == "downloads" { "暂无下载" } else { "暂无歌曲" }) { color: palette.secondary; font: .subheadline }
                }
              } else {
                List {
                  grow: 1; margin: [2,inset,4,inset]
                  appearance: .bare
                  for (i,e) in player.entries.enumerated() key e.key {
                    EntryRow(e, i, selecting, selected.contains(e.key)) {
                      on choose { if selecting { select(e.key) } else { action("choose", e.key, e.title) } }
                    }
                  }
                }
                if player.hasMore { Pill("加载更多","down",palette.accent,palette.accentWash) { on press { action("more") } } }
              }
            }
            if !player.trackTitle.isEmpty() {
              MiniPlayer { on open { showPanel("player") } }
            }
          }
          if !wide {
            View { height: 1; background: palette.rule }
            Navigation(false,panel) { on choose(p) { openTab(p) } }
          }
        }
      }
    }
    PlayerDialogs()
  }
}

component FolderTile(e: Entry, index: int, single: bool) {
  let palette = colorsFor(player.themeMode, environment().dark)
  event open
  View {
    direction: if single { .row } else { .column }; align: if single { .center } else { .stretch }
    grow: 1; basis: 0; shrink: 1; gap: if single { 16 } else { 4 }
    role: .button; label: e.title; on press { emit open }; pressed { opacity: 0.77 }
    View {
      width: if single { 102 } else { 100% }; aspectRatio: if single { 1.03 } else if environment().width >= 720 { 1.88 } else { 1.52 }
      radius: 9; clip: true; background: palette.surface
      CoverImage(e.coverUrl, albumFallback(index), 9.0)
    }
    Column {
      grow: if single { 1 } else { 0 }; shrink: 1; gap: 4; padding: [3,0,0,0]
      Text(e.title) { color: palette.ink; font: Font(size: if single { 21.0 } else { 16.0 }).medium(); lines: 2 }
      Text(e.detail) { color: palette.secondary; font: Font(size: 12); lines: 1 }
    }
    if single { Glyph("right", palette.secondary, 18.0) }
  }
}

component EntryRow(e: Entry, index: int, selecting: bool, checked: bool) {
  let palette = colorsFor(player.themeMode, environment().dark)
  event choose
  let downloads = player.page == "downloads"
  Row {
    background: if checked { palette.accentWash } else { palette.paper }
    radius: 6; padding: [7, 2]; gap: 12; align: .center
    Row {
      grow: 1; shrink: 1; align: .center; gap: 12; role: .button; label: e.title
      on press { emit choose }
      pressed { opacity: 0.7 }
      Art(e.coverUrl, 48.0, albumFallback(index), 5.0)
      Column {
        grow: 1; shrink: 1; gap: 4
        Text(e.title) { color: palette.ink; font: Font(size: 16).medium(); lines: 2 }
        Text(e.detail) { color: palette.secondary; font: Font(size: 12); lines: if downloads { 2 } else { 1 } }
      }
      if selecting {
        View { width: 22; height: 22; radius: 11; border: 1; borderColor: if checked { palette.accent } else { palette.rule }; background: if checked { palette.accent } else { palette.surface }; align: .center; justify: .center
          if checked { Glyph("check",palette.surface,14.0) }
        }
      } else if !downloads && e.video.isEmpty() { Glyph("right", palette.secondary, 14.0) }
    }
    if !selecting && !e.video.isEmpty() { IconAction("more", "视频操作", palette.secondary,palette.soft,40.0,19.0) { on press { videoMenu(e.video,e.title) } } }
    if downloads && !selecting {
      Column {
        gap: 3; shrink: 0
        if e.status == "QUEUED" || e.status == "DOWNLOADING" {
          Pill("暂停", "pause", palette.accent, palette.accentWash) { on press { action("downloadAction", e.key, "pause") } }
          Pill("取消", "", palette.secondary, palette.soft) { on press { action("downloadAction", e.key, "cancel") } }
        } else {
          if e.status != "COMPLETED" && e.status != "CONVERTING" { Pill(if e.status == "PAUSED" { "继续" } else { "重试" }, if e.status == "PAUSED" { "play" } else { "refresh" }, palette.accent, palette.accentWash) { on press { action("downloadAction", e.key, "retry") } } }
          Pill("移除", "", palette.secondary, palette.soft) { on press { action("downloadAction", e.key, "delete") } }
        }
      }
    }
  }
}

component LoginPane {
  let inset = contentInset(environment().width)
  let waiting = player.loginState == "waiting" && !player.qr.isEmpty()
  Scroll {
    grow: 1
    Column {
      padding: [8,inset,20,inset]; align: .center
      View {
        width: 100%; maxWidth: 720; minHeight: if waiting { 290 } else { 233 }
        radius: 14; clip: true; background: #16394E
        Image("stage-wide.jpg") {
          absolute: true; top: 0; left: 0; width: 100%; height: 100%; mode: .fill
        }
        View {
          absolute: true; top: 0; left: 0; width: 100%; height: 100%
          gradient: Gradient(stops: [Stop(color: #08243AEA, at: 0), Stop(color: #08243ACB, at: 0.38), Stop(color: #08243A00, at: 0.85)], startX: 0, startY: 0.5, endX: 1, endY: 0.5)
        }
        Column {
          grow: 1; justify: .center; align: .start; padding: 20; gap: 14
          if waiting {
            View { background: #FFFFFF; radius: 8; padding: 10
              Image(player.qr) { width: 160; height: 160 }
            }
            Text("请使用哔哩哔哩客户端扫码") { color: #F0FDFF; font: Font(size: 15).semibold() }
          } else if player.loginState == "error" || player.loginState == "expired" {
            Pill("重新获取二维码","refresh",#0C3546,#B3EFF2) { on press { action("retry") } }
          } else {
            Activity()
            Text("正在获取二维码") { color: #F1FDFF; font: .subheadline }
          }
        }
      }
    }
  }
}
