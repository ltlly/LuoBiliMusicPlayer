// Draw the four navigation marks with Asuka so they also work on systems
// without SF Symbols, Segoe Fluent Icons or an installed music font.
component Glyph(kind: string, tint: Color) {
  Canvas(g => {
    let stroke = StrokeStyle(width: 1.8, cap: .round)
    if kind == "favorites" {
      let heart = Path().move(12, 20).cubic(9, 17, 2, 12, 2, 7).cubic(2, 2, 9, 1, 12, 6).cubic(15, 1, 22, 2, 22, 7).cubic(22, 12, 15, 17, 12, 20)
      g.stroke(heart, tint, stroke)
    } else if kind == "library" {
      g.stroke(Path().move(8, 17).line(8, 6).line(20, 3).line(20, 14), tint, stroke)
      g.fill(Path().arc(5.5, 17, 3.2, start: 0, end: 6.283185), tint)
      g.fill(Path().arc(17.5, 14, 3.2, start: 0, end: 6.283185), tint)
    } else if kind == "downloads" {
      g.stroke(Path().move(12, 3).line(12, 15).move(6, 10).line(12, 16).line(18, 10).move(3, 17).line(3, 21).line(21, 21).line(21, 17), tint, stroke)
    } else {
      g.stroke(Path().move(3, 7).line(21, 7).move(3, 17).line(21, 17), tint, stroke)
      g.fill(Path().arc(8, 7, 3.2, start: 0, end: 6.283185), tint)
      g.fill(Path().arc(16, 17, 3.2, start: 0, end: 6.283185), tint)
    }
  }) { width: 24; height: 24 }
}
