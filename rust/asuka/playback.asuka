import std/json
import std/base

component MiniPlayer {
  let inset = contentInset(environment().width)
  event open
  Column {
    padding: [5, inset, 8, inset]
    View {
      radius: 15; clip: true; background: #15394C
      Row {
        align: .center; padding: [8, 11]; gap: 10
        Row {
          grow: 1; shrink: 1; align: .center; gap: 10; role: .button; label: "展开播放器"
          on press { emit open }
          Art(player.smallCoverUrl, 40.0, "singer-cover.jpg", 6.0)
          Column {
            grow: 1; shrink: 1; gap: 1
            Text(player.trackTitle) { color: #F1FDFF; font: Font(size: 14).bold(); lines: 1 }
            Text(player.artist) { color: #B7D3DF; font: Font(size: 12); lines: 1 }
          }
        }
        IconAction(if player.playing { "pause" } else { "play" }, if player.playing { "暂停" } else { "播放" }, #143341, #9AE7DE, 37.0, 17.0) { on press { control("toggle") } }
        IconAction("next", "下一首", #DFFAFF, #FFFFFF13, 34.0, 16.0) { on press { control("next") } }
      }
      Canvas(g => {
        g.stroke(Path().move(0,1).line(g.width,1), #FFFFFF22, StrokeStyle(width: 2))
        if player.duration > 0 {
          g.stroke(Path().move(0,1).line(g.width * min(1.0, player.position / player.duration),1), #9AE7DE, StrokeStyle(width: 2))
        }
      }) { height: 2 }
    }
  }
}

component NowPlaying(panel: string) {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  event dismiss
  event queue
  if panel == "player" && !player.trackTitle.isEmpty() {
    ImmersivePlayer { on dismiss { emit dismiss }; on queue { emit queue } }
  } else {
    Column {
      grow: 1; background: palette.paper; padding: [9,0]
      Row {
        padding: [4,inset]; align: .center; justify: .spaceBetween
        IconAction("down", "收起", palette.ink, #00000000, 44.0) { on press { emit dismiss } }
        Text("播放队列") { color: palette.ink; font: Font(size: 18).medium() }
        if !player.trackTitle.isEmpty() {
          IconAction("wave", "播放器", palette.accent, #00000000, 44.0) { on press { emit queue } }
        } else { View { width: 44 } }
      }
      if player.queue.isEmpty() && player.trackTitle.isEmpty() {
        Column {
          grow: 1; align: .center; justify: .center; gap: 12
          Glyph("queue", palette.accent, 29.0)
          Text("队列为空") { color: palette.ink; font: .headline }
          Pill("返回", "back", palette.accent, palette.accentWash) { on press { emit dismiss } }
        }
      } else if panel == "queue" {
        Row {
          padding: [10, inset]; align: .center; justify: .spaceBetween
          Text("{player.queue.count()} 首歌曲") { color: palette.secondary; font: .subheadline }
          if !player.queue.isEmpty() {
            Pill("清空队列", "minus", palette.ink, palette.soft) {
              on press { alert("清空播放队列？", actions: [.button(title: "取消", role: .cancel), .button(title: "清空", role: .destructive, run: () => control("clear"))]) }
            }
          }
        }
        List {
          appearance: .bare; grow: 1
          for (i,entry) in player.queue.enumerated() key i {
            Row {
              margin: [2, inset]; padding: [9,11]; radius: 8; gap: 11; align: .center
              background: if i == player.queueIndex { palette.accentWash } else { palette.paper }
              Row {
                grow: 1; shrink: 1; align: .center; gap: 10; role: .button; label: entry.title; on press { control("jump",i) }
                View {
                  width: 28; align: .center; justify: .center
                  if i == player.queueIndex { Glyph("wave",palette.accent,19.0) } else { Text("{i+1}") { color: palette.secondary; font: .footnote } }
                }
                Column {
                  grow: 1; shrink: 1; gap: 3
                  Text(entry.title) { color: palette.ink; font: .headline; lines: 1 }
                  Text(entry.detail) { color: palette.secondary; font: .footnote; lines: 1 }
                }
              }
              IconAction("minus", "移除歌曲", palette.secondary, #00000000, 37.0, 15.0) { on press { control("remove",i) } }
            }
          }
        }
      }
    }
  }
}

component ImmersivePlayer {
  event dismiss
  event queue
  state art = Artwork()
  task(player.largeCoverUrl) {
    art = Artwork()
    let url = player.largeCoverUrl
    if !url.isEmpty() {
      let raw = await spawn { lbm_player_art(url) }
      if player.largeCoverUrl == url {
        if let result = try? json.decode<Artwork>(raw) { art = result }
      }
    }
  }
  let wide = environment().width >= 720
  let inset = if wide { 32.0 } else { max(20.0, min(38.0, environment().width * 0.07)) }
  let height = environment().height
  // Reserve space for a two-line title, transport buttons and bottom navigation on shorter screens.
  let portraitSide = max(164.0, min(height * 0.48, height - 452.0))
  let side = if wide { max(175.0, min(335.0, (environment().width - 200.0) * 0.42)) } else { min(420.0, min(environment().width - inset * 2, portraitSide)) }
  View {
    grow: 1; background: #113347; clip: true
    Image(if art.ambience.isEmpty() { "stage-glow.jpg" } else { art.ambience }) {
      absolute: true; top: 0; left: 0; width: 100%; height: 100%; mode: .fill
    }
    View {
      absolute: true; top: 0; left: 0; width: 100%; height: 100%
      gradient: Gradient(stops: [Stop(color: #071D2B30, at: 0), Stop(color: #0923366B, at: 0.42), Stop(color: #091B2BDF, at: 0.81), Stop(color: #081925FA, at: 1)])
    }
    Column {
      grow: 1
      Row {
        padding: [8, inset]; align: .center; justify: .spaceBetween
        IconAction("down", "收起", #FFFFFF, #00000000, 44.0, 22.0) { on press { emit dismiss } }
        Text("正在播放") { color: #FFFFFF; font: Font(size: 15).medium() }
        IconAction("queue", "队列", #FFFFFF, #00000000, 44.0, 21.0) { on press { emit queue } }
      }
      Scroll {
        grow: 1
        Column {
          padding: if wide { [26, inset, 26, inset] } else { [max(9.0, min(39.0, (environment().height - 610.0) * 0.13)), inset, 24, inset] }
          gap: 34
          View {
            direction: if wide { .row } else { .column }; align: if wide { .center } else { .stretch }
            gap: if wide { 28 } else { max(18.0, min(35.0, environment().height * 0.042)) }
            View {
              width: side; height: side; alignSelf: .center; radius: 10
              shadow: Shadow(color: #00101D64, radius: 19, y: 8)
              Image(if art.cover.isEmpty() { "singer-cover.jpg" } else { art.cover }) {
                width: 100%; height: 100%; mode: .fill; radius: 10
              }
              Canvas(g => {
                let edge = StrokeStyle(width: 1.0, cap: .round)
                g.stroke(Path().move(8,37).line(8,17).quad(8,8,17,8).line(37,8), #D9FAFFBB, edge)
                g.stroke(Path().move(g.width-8,g.height-36).line(g.width-8,g.height-17).quad(g.width-8,g.height-8,g.width-17,g.height-8).line(g.width-37,g.height-8), #D9FAFFBB, edge)
                g.fill(Path().move(g.width-36,g.height-8).line(g.width-40,g.height-10.5).line(g.width-44,g.height-8).line(g.width-40,g.height-5.5).close(),#C3F2F1CC)
              }) { absolute: true; top: 0; left: 0; width: 100%; height: 100% }
            }
            TransportPanel()
          }
          if wide && !player.queue.isEmpty() {
            Column {
              gap: 0
              Row {
                justify: .spaceBetween; align: .center
                Text("播放队列") { color: #EFFDFF; font: Font(size: 20).medium() }
                Pill("查看全部", "queue", #AEECF4, #FFFFFF12) { on press { emit queue } }
              }
              for i in player.queueIndex..<min(player.queue.count(), player.queueIndex + 3) key i {
                Row {
                  align: .center; gap: 12; minHeight: 42; role: .button; label: player.queue[i].title
                  on press { control("jump", i) }; pressed { background: #FFFFFF14 }
                  View { width: 22; align: .center
                    if i == player.queueIndex { Glyph("wave", #8FE5ED, 17.0) }
                    else { Text("{i+1}") { color: #A8BDC9; font: .footnote } }
                  }
                  Text(player.queue[i].title) { grow: 1; shrink: 1; color: #F0FCFF; font: Font(size: 15); lines: 1 }
                  Text(player.queue[i].detail) { shrink: 1; color: #BCD4DE; font: .footnote; lines: 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}

component TransportPanel {
  let wide = environment().width >= 720
  Column {
    grow: if wide { 1 } else { 0 }; shrink: 1; gap: if wide { 18 } else { 12 }
    Column {
      gap: 3
      Text(player.trackTitle) { color: #F2FCFF; font: Font(size: if wide { 33.0 } else { 32.0 }).medium(); lines: 2 }
      if !player.artist.isEmpty() { Text(player.artist) { color: #CBE1E9; font: Font(size: 18); lines: 1 } }
    }
    Column {
      base.Slider {
        value: min(player.position, player.duration); max: max(1.0, player.duration); disabled: player.duration <= 0
        on valueChange(v) { if player.duration > 0 { action("seek", "{v}") } }
        base.SliderTrack {
          height: 31; justify: .center
          View { height: 4; radius: 2; background: #FFFFFF43 }
          base.SliderRange { justify: .center; View { height: 4; radius: 2; background: #A5E9F1 } }
          base.SliderThumb {
            label: "播放进度"; width: 24; height: 28; justify: .center; align: .center
            View { width: 9; height: 9; radius: 5; background: #FFFFFF }
          }
        }
      }
      Row {
        justify: .spaceBetween
        Text(clock(player.position)) { color: #B8CEDA; font: Font(size: 12) }
        Text(if player.duration > 0 { clock(player.duration) } else { "–:––" }) { color: #B8CEDA; font: Font(size: 12) }
      }
    }
    Row {
      align: .center; justify: .spaceBetween
      IconAction("shuffle", if player.shuffle { "随机已开启" } else { "随机播放" }, if player.shuffle { #8FE5ED } else { #B1CDD6 }, #00000000, 39.0, 20.0) { on press { control("shuffle") } }
      IconAction("previous", "上一首", #EEF9FF, #00000000, 44.0, 29.0) { on press { control("previous") } }
      IconAction(if player.playing { "pause" } else { "play" }, if player.playing { "暂停" } else { "播放" }, #123244, #A2E6F2, 59.0, 27.0) { on press { control("toggle") } }
      IconAction("next", "下一首", #EEF9FF, #00000000, 44.0, 29.0) { on press { control("next") } }
      IconAction(if player.repeatMode == 1 { "single" } else { "repeat" }, if player.repeatMode == 2 { "列表循环" } else if player.repeatMode == 1 { "单曲循环" } else { "顺序播放" }, if player.repeatMode > 0 { #8FE5ED } else { #B1CDD6 }, #00000000, 39.0, 20.0) { on press { control("repeat") } }
    }
  }
}
