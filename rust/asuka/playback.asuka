component MiniPlayer {
  let inset = contentInset(environment().width)
  event open
  Column {
    padding: [5, inset, 8, inset]
    View {
      radius: 15; clip: true; background: #272731
      Row {
        align: .center; padding: [8, 11]; gap: 10
        Row {
          grow: 1; shrink: 1; align: .center; gap: 10; role: .button; label: "展开播放器"
          on press { emit open }
          Art(player.smallCoverUrl, 40.0, "sleeve-tape.jpg", 6.0)
          Column {
            grow: 1; shrink: 1; gap: 1
            Text(player.trackTitle) { color: #FFFBF2; font: Font(size: 14).bold(); lines: 1 }
            Text(player.artist) { color: #C1BFCA; font: Font(size: 12); lines: 1 }
          }
        }
        IconAction(if player.playing { "pause" } else { "play" }, if player.playing { "暂停" } else { "播放" }, #27232C, orange, 37.0, 17.0) { on press { control("toggle") } }
        IconAction("next", "下一首", #F4EEE3, #FFFFFF13, 34.0, 16.0) { on press { control("next") } }
      }
      Canvas(g => {
        g.stroke(Path().move(0,1).line(g.width,1), #FFFFFF22, StrokeStyle(width: 2))
        if player.duration > 0 {
          g.stroke(Path().move(0,1).line(g.width * min(1.0, player.position / player.duration),1), orange, StrokeStyle(width: 2))
        }
      }) { height: 2 }
    }
  }
}

component TransportPanel {
  let palette = colorsFor(player.themeMode, environment().dark)
  let wide = environment().width >= 720
  Column {
    grow: if wide { 1 } else { 0 }; shrink: 1; gap: if wide { 24 } else { 14 }; justify: .center
    Column {
      gap: 4
      Text(player.trackTitle) { color: palette.ink; font: Font(size: if wide { 31.0 } else { 26.0 }).bold(); lines: 2 }
      if !player.artist.isEmpty() { Text(player.artist) { color: palette.secondary; font: Font(size: 15).medium(); lines: 1 } }
    }
    Column {
      gap: 3
      Slider { min: 0; max: max(1.0, player.duration); value: if player.duration > 0 { min(player.duration, player.position) } else { 0.0 }; label: "播放进度"; on change(v) { if player.duration > 0 { action("seek", "{v}") } } }
      Row {
        justify: .spaceBetween
        Text(clock(player.position)) { color: palette.secondary; font: Font(size: 12).family("monospace") }
        Text(if player.duration > 0 { clock(player.duration) } else { "–:––" }) { color: palette.secondary; font: Font(size: 12).family("monospace") }
      }
    }
    Row {
      justify: .spaceBetween; align: .center
      IconAction("shuffle", if player.shuffle { "随机已开启" } else { "随机播放" }, if player.shuffle { palette.violet } else { palette.secondary }, if player.shuffle { palette.violetWash } else { #00000000 }, 37.0, 19.0) { on press { control("shuffle") } }
      IconAction("previous","上一首",palette.ink,palette.soft,42.0,21.0) { on press { control("previous") } }
      IconAction(if player.playing { "pause" } else { "play" }, if player.playing { "暂停" } else { "播放" }, #FFF9ED, #4941C4, 64.0, 28.0) { on press { control("toggle") } }
      IconAction("next","下一首",palette.ink,palette.soft,42.0,21.0) { on press { control("next") } }
      IconAction(if player.repeatMode == 1 { "single" } else { "repeat" }, if player.repeatMode == 2 { "列表循环" } else if player.repeatMode == 1 { "单曲循环" } else { "顺序播放" }, if player.repeatMode > 0 { palette.violet } else { palette.secondary }, if player.repeatMode > 0 { palette.violetWash } else { #00000000 }, 37.0, 19.0) { on press { control("repeat") } }
    }
  }
}

component NowPlaying(panel: string) {
  let palette = colorsFor(player.themeMode, environment().dark)
  let inset = contentInset(environment().width)
  event dismiss
  event queue
  let wide = environment().width >= 720
  let side = if wide { min(285.0, max(198.0, (environment().width - 250.0) * 0.41)) } else { min(301.0, max(145.0, min(environment().width - 70.0, environment().height * 0.39))) }
  Column {
    grow: 1; background: palette.paper; padding: if wide { [16, 0] } else { [7, 0] }
    Row {
      padding: [5, inset]; align: .center; justify: .spaceBetween
      IconAction("down", "收起", palette.ink, palette.soft) { on press { emit dismiss } }
      Text(if panel == "queue" { "播放队列" } else { "正在播放" }) { color: palette.ink; font: Font(size: 17).bold() }
      if panel != "queue" || !player.trackTitle.isEmpty() {
        IconAction(if panel == "queue" { "wave" } else { "queue" }, if panel == "queue" { "播放器" } else { "队列" }, palette.violet, palette.violetWash) { on press { emit queue } }
      } else { View { width: 40 } }
    }
    if player.queue.isEmpty() && player.trackTitle.isEmpty() {
      Column {
        grow: 1; align: .center; justify: .center; gap: 12
        Glyph("queue", palette.violet, 29.0)
        Text("队列为空") { color: palette.ink; font: .headline }
        Pill("返回", "back", palette.violet, palette.violetWash) { on press { emit dismiss } }
      }
    } else if panel == "queue" {
      Row {
        padding: [10, inset]; align: .center; justify: .spaceBetween
        Text("{player.queue.count()} 首歌曲") { color: palette.secondary; font: .subheadline }
        if !player.queue.isEmpty() {
          Pill("清空队列", "minus", palette.ink, palette.soft) {
            on press { alert("清空播放队列？", actions: [.button(title: "取消", role: .cancel), .button(title: "清空", role: .destructive, run: () => control("clear"))]) }
          }
        }
      }
      List {
        grow: 1
        for (i,entry) in player.queue.enumerated() key i {
          Row {
            margin: [2, inset]; padding: [9,11]; radius: 12; gap: 11; align: .center
            background: if i == player.queueIndex { palette.violetWash } else { palette.surface }
            Row {
              grow: 1; shrink: 1; align: .center; gap: 10; role: .button; label: entry.title; on press { control("jump",i) }
              View {
                width: 28; align: .center; justify: .center
                if i == player.queueIndex { Glyph("wave",palette.violet,19.0) } else { Text("{i+1}") { color: palette.secondary; font: .footnote } }
              }
              Column {
                grow: 1; shrink: 1; gap: 3
                Text(entry.title) { color: palette.ink; font: .headline; lines: 1 }
                Text(entry.detail) { color: palette.secondary; font: .footnote; lines: 1 }
              }
            }
            IconAction("minus", "移除歌曲", palette.secondary, #00000000, 37.0, 15.0) { on press { control("remove",i) } }
          }
        }
      }
    } else {
      Scroll {
        grow: 1
        Column {
          gap: 32; padding: if wide { [30, 26] } else { [max(18.0, (environment().height - 655.0) * 0.25), 27, 27, 27] }
          View {
            direction: if wide { .row } else { .column }; align: if wide { .center } else { .stretch }
            gap: if wide { 28 } else { 24 }
            View {
              alignSelf: .center; radius: 15
              shadow: Shadow(color: #18103825, radius: 12, y: 5)
              Art(player.largeCoverUrl, side, "sleeve-tape.jpg", 15.0)
            }
            TransportPanel()
          }
          if wide && !player.queue.isEmpty() {
            Column {
              gap: 3
              Row {
                align: .center; justify: .spaceBetween; padding: [0, 0, 8, 0]
                Text("播放队列") { color: palette.ink; font: Font(size: 18).bold() }
                Pill("查看全部", "queue", palette.violet, palette.violetWash) { on press { emit queue } }
              }
              for i in player.queueIndex..<min(player.queue.count(), player.queueIndex + 3) key i {
                Row {
                  align: .center; gap: 12; minHeight: 46; padding: [7, 12]; radius: 9
                  background: if i == player.queueIndex { palette.violetWash } else { palette.surface }
                  role: .button; label: player.queue[i].title; on press { control("jump", i) }
                  View { width: 24; align: .center; justify: .center
                    if i == player.queueIndex { Glyph("wave", palette.violet, 18.0) }
                    else { Text("{i+1}") { color: palette.secondary; font: .footnote } }
                  }
                  Text(player.queue[i].title) { grow: 1; shrink: 1; color: palette.ink; font: Font(size: 14).semibold(); lines: 1 }
                  Text(player.queue[i].detail) { shrink: 1; color: palette.secondary; font: .footnote; lines: 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
