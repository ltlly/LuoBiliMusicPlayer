test "a restored library opens its existing player and queue" {
  player = Player(page: "library", trackTitle: "旧曲", artist: "歌手",
    entries: [Entry(key: "BV1", title: "收藏的曲目", detail: "歌手")],
    queue: [Entry(title: "旧曲", detail: "歌手")])
  let ui = mount(Music(false))
  ui.expect("收藏的曲目", "音乐库", "上一首", "播放", "下一首")
  ui.tap("队列")
  ui.expect("播放队列", "清空队列", "旧曲")
  ui.tap("播放器")
  ui.expect("正在播放", "上一首", "下一首")
}

test "an empty queue returns to the collection" {
  player = Player(page: "favorites", entries: [Entry(key: "1", title: "日落之后")])
  let ui = mount(Music(false))
  ui.expect("日落之后")
  ui.tap("队列")
  ui.expect("队列为空")
  ui.tap("返回")
  ui.expect("日落之后")
}

test "the immersive cover opens the restored track" {
  player = Player(page: "favorites", trackTitle: "夜色慢行", artist: "岛屿来信",
    entries: [Entry(key: "1", title: "日落之后"), Entry(key: "2", title: "潮汐唱片")],
    queue: [Entry(title: "夜色慢行")])
  let ui = mount(Music(false))
  ui.expect("日落之后", "潮汐唱片", "上一首", "播放", "下一首")
  ui.tap("展开播放器")
  ui.expect("正在播放", "夜色慢行", "上一首", "下一首")
}

test "closing the queue restores the player that opened it" {
  player = Player(page: "library", trackTitle: "夏虫", queue: [Entry(title: "夏虫")])
  let ui = mount(Music(false))
  ui.tap("展开播放器")
  ui.tap("队列")
  ui.expect("清空队列")
  ui.tap("收起")
  ui.expect("播放进度", "上一首", "下一首")
  ui.tap("收起")
  ui.expect("展开播放器", "音乐库")
}

test "the weekly chart exposes its source, filter and per-video actions" {
  player = Player(page: "rank", loggedIn: true, folderTitle: "第 745 期", rankDate: "2026-11-15",
    entries: [Entry(key: "BV17x411w7KC", video: "BV17x411w7KC", title: "测试歌曲", detail: "主榜", status: "01")])
  let ui = mount(Music(false))
  ui.expect("榜单官网", "未收藏", "第 745 期", "测试歌曲", "视频操作")
}

test "the weekly chart remains usable without an embedded browser" {
  player = Player(page: "rank", loggedIn: true, entries: [Entry(key: "BV17x411w7KC", title: "测试歌曲")])
  rankInBrowser = true
  let ui = mount(Music(false))
  ui.expect("在浏览器打开官网", "未收藏", "测试歌曲", "视频操作")
  rankInBrowser = false
}

test "a partial collection index is distinct from an empty result" {
  player = Player(page: "rank", loggedIn: true, rankFiltered: true, rankVerified: false)
  let ui = mount(Music(false))
  ui.expect("收藏夹尚未核对完成，可点刷新重试")
}

test "playing the uncollected list selects the first visible song" {
  player = Player(page: "rank", loggedIn: true, rankFiltered: true, rankVerified: true,
    entries: [Entry(key: "BV17x411w7KC", title: "第一首", detail: "主榜"), Entry(key: "BV1AZxH6PEMi", title: "第二首", detail: "主榜")])
  let ui = mount(Music(false))
  ui.tap("播放未收藏")
  ui.expect("正在准备播放…")
}

test "video actions open and dismiss inside the player" {
  player = Player(page: "rank", loggedIn: true, entries: [Entry(key: "BV17x411w7KC", title: "未收藏的歌曲", status: "01")])
  let ui = mount(Music(false))
  ui.tap("视频操作")
  ui.expect("在哔哩哔哩打开", "一键三连（含投币）", "取消")
  ui.tap("取消")
  ui.expect("未收藏的歌曲", "视频操作")
}

test "reopening the library displays its local rows on the tap" {
  rememberTab(Player(page: "library", entries: [Entry(key: "saved", title: "已下载的歌曲")]), "")
  player = Player(page: "settings", loggedIn: true)
  let ui = mount(Music(false))
  ui.tap("音乐库")
  ui.expect("已下载的歌曲", "音乐库")
}

test "settings opens while the previous tab is still refreshing" {
  player = Player(page: "favorites", pageLoading: true, loggedIn: true, account: "测试账户")
  let ui = mount(Music(false))
  ui.tap("设置")
  ui.expect("测试账户", "外观主题", "下载设置")
}
